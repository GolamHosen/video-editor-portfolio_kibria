# ==========================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# Database (Required) - MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kibria_portfolio?retryWrites=true&w=majority"

# Cloudinary (Required for media uploads & images)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Admin Authentication & Security (Required)
JWT_SECRET="generate-a-long-random-secret-key-for-jwt"
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Optional: Upstash Redis (For caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Gmail SMTP (For contact form email delivery)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-16-character-app-password"
TO_EMAIL="your-notification-destination@email.com"

# Optional: Custom App URL (e.g., https://yourdomain.com)
NEXT_PUBLIC_APP_URL=""
